{
  "name": "P+R Flächenfinder Rhein-Main",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": { "ghcr.io/devcontainers/features/go:1": {} },
  "postCreateCommand": "pip install -r requirements.txt && python scripts/erzeuge_testbasemap.py && (python scripts/hole_basemap.py || true)",
  "postAttachCommand": "uvicorn app.main:app --host 0.0.0.0 --port 8000",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "P+R Flächenfinder", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
